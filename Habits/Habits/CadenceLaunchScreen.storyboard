<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="vc-launch">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="scene-launch">
            <objects>
                <viewController id="vc-launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="logo-container">
                                <rect key="frame" x="72.666666666666686" y="377.66666666666669" width="248" height="99"/>
                                <subviews>
                                    <imageView userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchProSwoosh" translatesAutoresizingMaskIntoConstraints="NO" id="swoosh-image">
                                        <rect key="frame" x="31" y="0.0" width="80" height="4"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="4" id="swoosh-height"/>
                                            <constraint firstAttribute="width" constant="80" id="swoosh-width"/>
                                        </constraints>
                                    </imageView>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Cadence" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="title-label">
                                        <rect key="frame" x="31" y="18" width="185.66666666666666" height="55"/>
                                        <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="46"/>
                                        <color key="textColor" red="0.92941176470588238" green="0.92941176470588238" blue="0.92941176470588238" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                    </label>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Where habits become performance" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="subtitle-label">
                                        <rect key="frame" x="0.0" y="81" width="248" height="18"/>
                                        <fontDescription key="fontDescription" type="system" weight="medium" pointSize="15"/>
                                        <color key="textColor" red="0.92941176470588238" green="0.92941176470588238" blue="0.92941176470588238" alpha="0.83999999999999997" colorSpace="custom" customColorSpace="sRGB"/>
                                    </label>
                                </subviews>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <constraints>
                                    <constraint firstAttribute="bottom" secondItem="subtitle-label" secondAttribute="bottom" id="container-bottom-to-subtitle"/>
                                    <constraint firstAttribute="top" secondItem="swoosh-image" secondAttribute="top" id="container-top-to-swoosh"/>
                                    <constraint firstAttribute="trailing" secondItem="subtitle-label" secondAttribute="trailing" id="container-trailing-to-subtitle"/>
                                    <constraint firstItem="subtitle-label" firstAttribute="leading" secondItem="logo-container" secondAttribute="leading" id="subtitle-leading"/>
                                    <constraint firstItem="subtitle-label" firstAttribute="top" secondItem="title-label" secondAttribute="bottom" constant="8" id="subtitle-top-to-title-bottom"/>
                                    <constraint firstItem="swoosh-image" firstAttribute="bottom" secondItem="title-label" secondAttribute="top" constant="-14" id="swoosh-bottom-to-title-top"/>
                                    <constraint firstItem="swoosh-image" firstAttribute="leading" secondItem="title-label" secondAttribute="leading" id="swoosh-leading-to-title"/>
                                    <constraint firstItem="title-label" firstAttribute="centerX" secondItem="logo-container" secondAttribute="centerX" id="title-centerx"/>
                                </constraints>
